# /etc/crontab: system-wide crontab read by crond.
#
# Each line runs a command at the times matched by its five time fields:
#
# .---------------- minute       (0 - 59)
# |  .------------- hour         (0 - 23)
# |  |  .---------- day of month (1 - 31)
# |  |  |  .------- month        (1 - 12)
# |  |  |  |  .---- day of week  (0 - 6, Sunday = 0)
# |  |  |  |  |
# *  *  *  *  *  command
#
# A field may be '*' (any value), a number, a list (1,15), a range (1-5)
# or a step (*/10). Lines starting with '#' and empty lines are ignored.

SHELL=/bin/sh
PATH=/usr/sbin:/usr/bin:/sbin:/bin

# Every 15 minutes: flush dirty buffers to disk.
*/15 *  *  *  *    sync
