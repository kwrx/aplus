
mainmenu "Configure aplus build"

menu "System environment"

    config SYSTEM_NAME
        string "Project Name"
        default "aplus"

    config SYSTEM_VERSION
        string "Project Version"
        default "0.7"

    config SYSTEM_CODENAME
        string "Project Codename"
        default "zeta"


    comment "All paths are relative to the current working directory"

    config SYSTEM_PATH_SYSROOT
        string "Sysroot path"
        default "root"

    config SYSTEM_PATH_TOOLCHAIN
        string "Toolchain path"
        default "sdk/toolchain"


    config SYSTEM_LOCALE
        string "Locale"
        default "it-IT"

    config SYSTEM_TIMEZONE
        string "Timezone"
        default "Europe/Rome"


endmenu


menu "Compiler"

    config COMPILER_HOST
        string "Host Machine"
        default "x86_64"
        help 
            It specifies the platform on which whatever we are building is going to be run.
            Supported platforms: x86_64, armv7, aarch64

    config COMPILER_STRIP_BINARIES
        bool "Strip all binary files"
        default y
        depends on !HAVE_DEBUG
        help
            Removes symbols and sections from files to reduce file size.

    config COMPILER_OMIT_FRAME_POINTER
        bool "Omit frame pointer"
        default y
        depends on !HAVE_DEBUG
        help
            Instructs the compiler to not store stack frame pointers if the function
            does not need it. You can use this option to reduce the code image size.

    config COMPILER_OPTIMIZATION_LEVEL
        int "Compiler optimization level -O{n}"
        default 3
        range 0 3
        depends on !HAVE_DEBUG
        help
            Turning on optimization makes the compiler attempt to improve the performance
            and/or code size at the expense of compilation time and possibly the ability
            to debug the program.


    config COMPILER_EXTRA_CFLAGS
        string "Extra CFLAGS"
        default ""

    config COMPILER_EXTRA_CXXFLAGS
        string "Extra CXXFLAGS"
        default ""

    config COMPILER_EXTRA_ASFLAGS
        string "Extra ASFLAGS"
        default ""

    config COMPILER_EXTRA_LDFLAGS
        string "Extra LDFLAGS"
        default ""

endmenu



menu "Options"

    config HAVE_SANITIZERS
        bool "Enable Sanitizers"
        default n
        help
            Enable various sanitizers to detect bugs in the kernel and drivers code.

    config BUFSIZ
        int "BUFSIZ"
        default 1024

    config PATH_MAX
        int "PATH_MAX"
        default 4096

    config NAME_MAX
        int "NAME_MAX"
        default 255

    config PIPESIZ
        int "PIPESIZ"
        default 65535

    config MAXNAMLEN
        int "MAXNAMLEN"
        default 512

    config OPEN_MAX
        int "OPEN_MAX"
        default 256

    config FILE_MAX
        int "FILE_MAX"
        default 8192

    config SOCKET_MAX
        int "SOCKET_MAX"
        default 20

    config MMAP_MAX
        int "MMAP_MAX"
        default 256

endmenu


menu "AI"

    config HAVE_AI
        bool "Enable AI"
        default y

    config HUGGINGFACE_API_KEY
        string "Hugging Face API Key"
        default ""
        depends on HAVE_AI
        help
            The Hugging Face API key is required to access the Hugging Face API for AI-related tasks.
            You can obtain an API key by signing up on the Hugging Face website.

    config HUGGINGFACE_MODEL
        string "Hugging Face Model"
        default "inclusionAI/Ling-3.0-flash-Fin"
        depends on HAVE_AI
        help
            The Hugging Face model to use for AI tasks. You can choose from various models available on the Hugging Face platform.

endmenu


menu "Packages"

    config HAVE_GAMES_DOOM
        bool "Doom"
        default n

    config HAVE_GAMES_NESEMU
        bool "NES Emulator"
        default n

    menu "Terminal"

        config HAVE_ATERM
            bool "Terminal"
            default y

        config ATERM_FONT_PATH
            string "Terminal font"
            default "/usr/share/fonts/ttf/UbuntuMono-R.ttf"
            depends on HAVE_ATERM
            help
                The monospaced face the terminal draws with, as a path: there is no
                fontconfig in the sysroot, so a family name resolves to nothing.

        config ATERM_FONT_BOLD_PATH
            string "Terminal bold font"
            default "/usr/share/fonts/ttf/UbuntuMono-B.ttf"
            depends on HAVE_ATERM
            help
                The face bold cells are drawn with. The regular one stands in for it
                when it cannot be loaded.

        config ATERM_FONT_SIZE
            int "Terminal font size"
            default 16
            depends on HAVE_ATERM
            help
                The pixel size the faces are scaled to, which is what decides the cell
                size and so how many columns and rows a window of a given size holds.

    endmenu

endmenu


menu "Architecture"
    source "arch/x86-family/.config"

    config HAVE_PCI_MSIX
        bool "Enable PCI MSI-X Interrupts"
        default y
        
endmenu

config HAVE_DEBUG
    bool "Enable Debugging"
    default n

    config DEBUG_LEVEL
        int "Debugging Level"
        range 0 4
        default 0
        depends on HAVE_DEBUG

    config DEBUG_SERIAL_OUTPUT
        bool "Debugging output on serial port /dev/sr0"
        default y
        depends on HAVE_DEBUG

    config HAVE_TEST
        bool "Enable Test"
        default n

