#!/bin/bash

# Usage
#   gen-image [OPTIONS] SOURCE OUTPUT

# This script generates a raw UEFI GPT image without loop devices, mounts, or
# elevated privileges.

set -euo pipefail

readonly IMAGE_SIZE=2147483648
readonly EFI_START_SECTOR=2048
readonly EFI_END_SECTOR=93716
readonly EFI_SIZE=46934528
readonly ROOT_START_SECTOR=94208
readonly ROOT_END_SECTOR=4192255
readonly ROOT_SIZE=2098200576
readonly ROOT_LABEL="APLUS"

LIVE_MODE=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h | --help)
            echo "Usage: gen-image [OPTIONS] SOURCE OUTPUT"
            echo "  SOURCE: The source directory to generate the image from."
            echo "  OUTPUT: The destination file to generate."
            echo "  OPTIONS:"
            echo "    -h, --help: Show this help message."
            echo "        --live: Generate a live image."
            exit 0
            ;;
        --live)
            LIVE_MODE=1
            shift
            ;;
        -*)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

SOURCE="${1:-}"
OUTPUT="${2:-}"

if [ -z "$SOURCE" ] || [ ! -d "$SOURCE" ]; then
    echo "No valid source directory specified." >&2
    exit 1
fi

if [ -z "$OUTPUT" ]; then
    echo "No destination file specified." >&2
    exit 1
fi

for command in cp dd find gzip grub-mkstandalone mcopy mke2fs mmd mkfs.vfat mv sgdisk tar truncate; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "gen-image: missing required command: $command" >&2
        exit 1
    fi
done

WORKDIR=$(mktemp -d "${TMPDIR:-/tmp}/aplus-image.XXXXXX")
STAGING_ROOT="$WORKDIR/root"
EFI_IMAGE="$WORKDIR/efi.img"
ROOT_IMAGE="$WORKDIR/root.img"
BOOTSTRAP_CONFIG="$WORKDIR/grub-bootstrap.cfg"
BOOTX64="$WORKDIR/BOOTX64.EFI"
OUTPUT_TMP="$(dirname "$OUTPUT")/.$(basename "$OUTPUT").tmp.$$"

cleanup() {
    rm -rf "$WORKDIR"

    if [ -n "${OUTPUT_TMP:-}" ]; then
        rm -f "$OUTPUT_TMP"
    fi
}

trap cleanup EXIT INT TERM

mkdir -p "$STAGING_ROOT"

if [ "$LIVE_MODE" -eq 1 ]; then
    if [ ! -d "$SOURCE/boot" ] || [ ! -d "$SOURCE/usr/lib/modules" ]; then
        echo "gen-image: live image requires boot files and kernel modules" >&2
        exit 1
    fi

    if [ ! -f /tmp/aplus-initrd/initrd.img ]; then
        echo "gen-image: live image requires /tmp/aplus-initrd/initrd.img" >&2
        exit 1
    fi

    mkdir -p "$STAGING_ROOT/boot" "$STAGING_ROOT/usr/lib/modules"
    cp -a "$SOURCE/boot/." "$STAGING_ROOT/boot/"
    cp -a "$SOURCE/usr/lib/modules/." "$STAGING_ROOT/usr/lib/modules/"
    cp -a /tmp/aplus-initrd/initrd.img "$STAGING_ROOT/boot/initrd.img"
else
    cp -a "$SOURCE/." "$STAGING_ROOT/"
fi

if [ ! -f "$STAGING_ROOT/boot/aplus" ]; then
    echo "gen-image: kernel image not found at $SOURCE/boot/aplus" >&2
    exit 1
fi

if [ ! -f "$STAGING_ROOT/boot/grub/grub.cfg" ]; then
    echo "gen-image: GRUB configuration not found at $SOURCE/boot/grub/grub.cfg" >&2
    exit 1
fi

while IFS= read -r -d '' module; do
    echo "    GZIP    ${module#"$STAGING_ROOT/"}"
    gzip -f "$module"
done < <(find "$STAGING_ROOT/usr/lib/modules" -type f -name "*.ko" -print0)

for file in "$STAGING_ROOT/usr/lib/modules/exports" "$STAGING_ROOT/boot/aplus"; do
    if [ -f "$file" ]; then
        echo "    GZIP    ${file#"$STAGING_ROOT/"}"
        gzip -f "$file"
    fi
done

if [ "$LIVE_MODE" -eq 1 ]; then
    echo "    GZIP    boot/initrd.img"
    gzip -f "$STAGING_ROOT/boot/initrd.img"
fi

cat >"$BOOTSTRAP_CONFIG" <<EOF
search --no-floppy --label --set=root $ROOT_LABEL
configfile /boot/grub/grub.cfg
EOF

echo "    GEN     EFI/BOOT/BOOTX64.EFI"
grub-mkstandalone \
    --format=x86_64-efi \
    --output="$BOOTX64" \
    --modules="part_gpt part_msdos fat ext2 normal configfile search search_label multiboot2 gzio progress all_video" \
    "/boot/grub/grub.cfg=$BOOTSTRAP_CONFIG"

truncate -s "$EFI_SIZE" "$EFI_IMAGE"
mkfs.vfat -F 32 -n EFI "$EFI_IMAGE" >/dev/null
mmd -i "$EFI_IMAGE" ::/EFI
mmd -i "$EFI_IMAGE" ::/EFI/BOOT
mcopy -i "$EFI_IMAGE" "$BOOTX64" ::/EFI/BOOT/BOOTX64.EFI

if [ "$LIVE_MODE" -eq 1 ]; then
    truncate -s "$ROOT_SIZE" "$ROOT_IMAGE"
    mkfs.vfat -F 32 -n "$ROOT_LABEL" "$ROOT_IMAGE" >/dev/null
    mcopy -s -i "$ROOT_IMAGE" "$STAGING_ROOT"/* ::/
else
    truncate -s "$ROOT_SIZE" "$ROOT_IMAGE"
    tar --numeric-owner --owner=0 --group=0 -cf - -C "$STAGING_ROOT" . |
        mke2fs -q -F -t ext2 -L "$ROOT_LABEL" -m 0 -d - "$ROOT_IMAGE"
fi

echo "    GEN     $OUTPUT"
truncate -s "$IMAGE_SIZE" "$OUTPUT_TMP"
sgdisk \
    --clear \
    --new=1:"$EFI_START_SECTOR":"$EFI_END_SECTOR" \
    --typecode=1:ef00 \
    --change-name=1:EFI \
    --new=2:"$ROOT_START_SECTOR":"$ROOT_END_SECTOR" \
    --typecode=2:8300 \
    --change-name=2:aplus \
    "$OUTPUT_TMP" >/dev/null

dd if="$EFI_IMAGE" of="$OUTPUT_TMP" bs=512 seek="$EFI_START_SECTOR" conv=notrunc,sparse status=none
dd if="$ROOT_IMAGE" of="$OUTPUT_TMP" bs=512 seek="$ROOT_START_SECTOR" conv=notrunc,sparse status=none

mv -f "$OUTPUT_TMP" "$OUTPUT"
OUTPUT_TMP=""
