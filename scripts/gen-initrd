#!/bin/bash

# Usage
#   gen-initrd SYSROOT

# This script generates an initrd for the given sysroot.


set -euo pipefail

OUTPUT_DIR="/tmp/aplus-initrd"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    echo "Usage: gen-initrd SYSROOT"
    echo "  SYSROOT: The sysroot to generate an initrd for."
    exit 0
fi

if [ -z "${1:-}" ] || [ ! -d "$1" ]; then
    echo "No valid sysroot specified." >&2
    exit 1
fi

SYSROOT="$1"

for command in fakeroot mke2fs tar; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "gen-initrd: missing required command: $command" >&2
        exit 1
    fi
done

rm -rf "$OUTPUT_DIR"
mkdir -p "$OUTPUT_DIR"

STAGING_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/aplus-initrd.XXXXXX")
trap 'rm -rf "$STAGING_ROOT"' EXIT

tar -C "$SYSROOT" \
    --exclude='./boot' \
    --exclude='./boot/*' \
    --exclude='./usr/lib/modules' \
    --exclude='./usr/lib/modules/*' \
    -cf - . | tar -C "$STAGING_ROOT" -xf -

FREE_KIB=$((25 * 1024))

IMAGE_SIZE_KIB=$(du -sk "$STAGING_ROOT" | cut -f1)
IMAGE_SIZE_KIB=$((IMAGE_SIZE_KIB + IMAGE_SIZE_KIB / 20 + FREE_KIB))

for pass in 1 2 3; do
    rm -f "$OUTPUT_DIR/initrd.img"

    fakeroot -- /bin/sh -c \
        'chown -R 0:0 "$1" && mke2fs -q -F -t ext2 -b 4096 -m 0 -d "$1" "$2" "${3}K"' \
        _ "$STAGING_ROOT" "$OUTPUT_DIR/initrd.img" "$IMAGE_SIZE_KIB"

    FREE_BLOCKS=$(dumpe2fs -h "$OUTPUT_DIR/initrd.img" 2>/dev/null | sed -n 's/^Free blocks: *//p')
    MISSING_KIB=$((FREE_KIB - FREE_BLOCKS * 4))

    if [ "$MISSING_KIB" -le 0 ] && [ "$MISSING_KIB" -gt -4096 ]; then
        break
    fi

    IMAGE_SIZE_KIB=$((IMAGE_SIZE_KIB + MISSING_KIB + 1024))
done
